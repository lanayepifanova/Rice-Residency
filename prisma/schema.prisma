generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventSeriesStatus {
  draft
  active
  cancelled
}

enum EventInstanceStatus {
  scheduled
  cancelled
  moved
}

enum EventVisibility {
  public
}

enum RsvpStatus {
  going
  maybe
  busy
  waitlisted
}

enum NotificationEventType {
  event_series_created
  user_invited
  share_opened
  rsvp_changed
  capacity_reached
  waitlist_position_changed
  waitlist_promoted
  instance_reminder
  instance_changed
  instance_cancelled
  series_cancelled
}

enum NotificationChannel {
  in_app
  email
  push
  sms
}

enum NotificationDeliveryStatus {
  pending
  sent
  failed
  skipped
}

model User {
  /// This app owns identity outright: there is no external auth provider, so
  /// the id is minted here when the account is created.
  id        String   @id @default(uuid())
  /// Always present — sign-in is keyed on email.
  email     String   @unique
  /// scrypt hash of the account password, in the format written by
  /// `src/lib/server/password.ts`. Nullable because a person can exist before
  /// they have credentials: seeded rows and invited emails both start here.
  passwordHash String?
  /// Unknown at sign-up; the user sets it on their profile afterwards.
  name      String?
  /// Public handle. Unique when set, but optional so sign-in never blocks on it.
  username  String?  @unique
  phone     String?
  /// Path of the avatar under `public/uploads`, served as a plain static file.
  avatarUrl String?
  bio       String?
  instagram String?
  twitter   String?

  /// Where someone is in school. Free text rather than an enum: "Junior",
  /// "PhD 3", and "Alum '24" are all answers people actually give.
  riceYear String?
  major    String?

  /// What this person is building. The house is a residency, so the project is
  /// as much a part of a profile as the name is — it is what people are here to
  /// find each other over.
  projectName    String?
  projectSummary String?
  projectUrl     String?

  /// The rest of the picture: what they have already shipped, and where they
  /// are stuck. The second one is the reason to read a profile at all — it is
  /// the ask someone else in the house might be able to answer.
  pastProjects String?
  helpNeeded   String?
  /// Date only. Stored as a string so a timezone can never shift someone's
  /// birthday across a day boundary.
  birthday  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizedSeries        EventSeries[]
  rsvps                  EventRsvp[]
  notificationPreference NotificationPreference?
  notificationDeliveries NotificationDelivery[]
  notificationsActed     NotificationEvent[]     @relation("NotificationActor")
  invitesSent            EventInvite[]           @relation("InviteSender")
  invitesAccepted        EventInvite[]           @relation("InviteRecipient")
  shareLinksCreated      EventShareLink[]
  sessions               Session[]
  gamePlayer             GamePlayer?
}

/// A signed-in browser.
///
/// Sessions live in the database rather than in a signed cookie so that signing
/// out actually revokes access instead of merely asking the browser to forget a
/// token it could still replay.
model Session {
  /// SHA-256 of the cookie value, never the value itself. A leaked database
  /// dump therefore cannot be used to impersonate anyone.
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EventSeries {
  id           String  @id @default(cuid())
  organizerId  String
  title        String
  description  String?
  coverImage   String?
  locationName String?
  locationUrl  String?
  timezone     String

  /// Wall-clock local start, e.g. "2026-09-07T18:30". Deliberately a string:
  /// a timestamp column would force a UTC interpretation, and the whole point
  /// of a recurring series is that "18:30 in America/New_York" stays 18:30
  /// even when the UTC offset changes at a DST boundary.
  startsAtLocal   String
  durationMinutes Int
  capacity        Int?
  waitlistEnabled Boolean         @default(true)
  visibility      EventVisibility @default(public)

  recurrenceRule  Json
  recurrenceUntil DateTime?
  recurrenceCount Int?
  maxHorizonYears Int       @default(10)
  /// How far ahead instances have been generated. Materialization is a rolling
  /// window, so this marks where the next top-up should resume.
  materializedThrough DateTime?

  status    EventSeriesStatus @default(active)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  organizer          User                @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  instances          EventInstance[]
  shareLinks         EventShareLink[]
  invites            EventInvite[]
  notificationEvents NotificationEvent[]

  @@index([organizerId])
  @@index([status])
}

model EventInstance {
  id        String   @id @default(cuid())
  seriesId  String
  startsAt  DateTime
  endsAt    DateTime
  localDate String

  status EventInstanceStatus @default(scheduled)

  /// The photo for this date. Assigned once when the occurrence is generated
  /// and stored rather than derived, so the card in a list and the page it
  /// opens always show the same picture no matter how either is queried.
  coverImage String?

  /// Single-occurrence overrides. Null means "inherit from the series", which
  /// is why these are separate nullable columns rather than a JSON blob: an
  /// override that is set to empty string is meaningfully different from one
  /// that was never set, and both stay queryable.
  overrideTitle        String?
  overrideDescription  String?
  overrideLocationName String?

  ruleVersion Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  series             EventSeries         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  rsvps              EventRsvp[]
  shareLinks         EventShareLink[]
  notificationEvents NotificationEvent[]

  /// Makes materialization idempotent: re-running the generator for a series
  /// can never produce a duplicate occurrence at the same instant.
  @@unique([seriesId, startsAt])
  @@index([seriesId, startsAt])
  @@index([status])
  @@index([startsAt])
}

model EventRsvp {
  id         String     @id @default(cuid())
  instanceId String
  userId     String
  status     RsvpStatus
  guestCount Int        @default(0)
  /// Seats consumed: `1 + guestCount` for `going`, otherwise 0. Denormalised so
  /// capacity can be summed in the database instead of in application code.
  partySize    Int      @default(0)
  waitlistRank Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instance EventInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instanceId, userId])
  @@index([instanceId, status])
  @@index([userId])
}

model EventShareLink {
  id           String    @id @default(cuid())
  token        String    @unique
  seriesId     String?
  instanceId   String?
  createdById  String?
  openCount    Int       @default(0)
  lastOpenedAt DateTime?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  series    EventSeries?   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  instance  EventInstance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([seriesId])
  @@index([instanceId])
}

model EventInvite {
  id                String   @id @default(cuid())
  seriesId          String
  /// Invites are addressed to an email because the recipient usually has no
  /// account yet. `acceptedByUserId` links it up once they sign in.
  email             String
  invitedById       String?
  acceptedByUserId  String?
  acceptedAt        DateTime?
  createdAt         DateTime @default(now())

  series         EventSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  invitedBy      User?       @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedByUser User?       @relation("InviteRecipient", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@unique([seriesId, email])
  @@index([email])
}

model NotificationEvent {
  id         String                @id @default(cuid())
  type       NotificationEventType
  seriesId   String?
  instanceId String?
  actorId    String?
  /// Stable identity for an event that must only ever happen once, e.g.
  /// "capacity_reached:<instanceId>". Unique, so a duplicate insert is
  /// rejected by the database rather than by a racy pre-check.
  dedupeKey  String?               @unique
  payload    Json
  createdAt  DateTime              @default(now())

  series     EventSeries?           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  instance   EventInstance?         @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actor      User?                  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@index([type, createdAt])
}

model NotificationDelivery {
  id                  String                     @id @default(cuid())
  notificationEventId String
  userId              String
  channel             NotificationChannel
  status              NotificationDeliveryStatus @default(pending)
  attempts            Int                        @default(0)
  lastError           String?
  sentAt              DateTime?
  /// In-app only: when the recipient saw it. Drives the unread badge.
  readAt              DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  notificationEvent NotificationEvent @relation(fields: [notificationEventId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationEventId, userId, channel])
  @@index([status, createdAt])
  @@index([userId, channel, readAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  inApp     Boolean  @default(true)
  email     Boolean  @default(false)
  push      Boolean  @default(false)
  sms       Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A card game the house keeps a running tally for.
model CardGame {
  id   String @id @default(cuid())
  name String
  /// Addressable in a URL, and the stable key results are imported against: a
  /// game's display name can be reworded without orphaning its rows.
  slug String @unique
  /// House rules, the usual stakes, whatever is worth saying about it.
  description String?
  /// Manual ordering, so the game the house actually plays sits above the one
  /// tried once, rather than whichever sorts first alphabetically.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions GameSession[]
}

/// Someone who plays. Deliberately not the same thing as a `User`.
///
/// Most people at the table have no account — the tally predates anyone signing
/// up, and turning every player into a `User` would list them in the house
/// directory as a resident with a blank profile. `userId` links the ones who do
/// have accounts, so their name in the standings reaches their profile.
model GamePlayer {
  id     String  @id @default(cuid())
  name   String
  slug   String  @unique
  userId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  scores GameSessionScore[]
}

/// One sitting: a date, a game, and the number of rounds played.
///
/// Scores are stored per sitting rather than as a running total per person,
/// because that is the shape results are actually recorded in. Adding a night
/// is then additive, and the totals on the standings page stay a derivation
/// rather than a number somebody has to remember to update.
model GameSession {
  id     String @id @default(cuid())
  gameId String
  /// Date only, as text. The house records a night, not an instant, and a
  /// timestamp column would drag a timezone into a value that has none.
  playedOn String
  /// Rounds played that night. This is the denominator for a player's share,
  /// and it is stored rather than counted from the score rows because a round
  /// with two winners produces two of them.
  rounds Int
  /// Separates two sittings of the same game on one date — 15 July went Cambio,
  /// then Chinese Poker, then Cambio again.
  ordinal Int     @default(1)
  note    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game   CardGame           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  scores GameSessionScore[]

  @@unique([gameId, playedOn, ordinal])
  @@index([gameId, playedOn])
}

/// What one player scored in one sitting.
model GameSessionScore {
  id        String @id @default(cuid())
  sessionId String
  playerId  String
  /// Rounds won that night. A round shared by two players — a tie, or a team
  /// win — counts one point each, which is how the house scores it.
  points Int @default(0)

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  GamePlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId])
  @@index([playerId])
}
