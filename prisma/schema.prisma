generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventSeriesStatus {
  draft
  active
  cancelled
}

enum EventInstanceStatus {
  scheduled
  cancelled
  moved
}

enum EventVisibility {
  public
}

enum RsvpStatus {
  going
  maybe
  busy
  waitlisted
}

enum NotificationEventType {
  event_series_created
  share_opened
  rsvp_changed
  capacity_reached
  waitlist_position_changed
  waitlist_promoted
  instance_reminder
  instance_changed
  instance_cancelled
  series_cancelled
}

enum NotificationChannel {
  in_app
  email
  push
  sms
}

enum NotificationDeliveryStatus {
  pending
  sent
  failed
  skipped
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizedSeries        EventSeries[]
  rsvps                  EventRsvp[]
  notificationPreference NotificationPreference?
  notificationDeliveries NotificationDelivery[]
}

model EventSeries {
  id              String            @id @default(cuid())
  organizerId     String
  title           String
  description     String?
  locationName    String?
  locationUrl     String?
  timezone        String
  startsAtLocal   DateTime
  durationMinutes Int
  capacity        Int?
  waitlistEnabled Boolean           @default(true)
  visibility      EventVisibility   @default(public)
  recurrenceRule  Json
  recurrenceUntil DateTime?
  recurrenceCount Int?
  maxHorizonYears Int               @default(10)
  status          EventSeriesStatus @default(active)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organizer          User                @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  instances          EventInstance[]
  shareLinks         EventShareLink[]
  notificationEvents NotificationEvent[]

  @@index([organizerId])
  @@index([status])
}

model EventInstance {
  id             String              @id @default(cuid())
  seriesId       String
  startsAt       DateTime
  endsAt         DateTime
  localDate      String
  status         EventInstanceStatus @default(scheduled)
  overrideFields Json?
  ruleVersion    Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  series             EventSeries         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  rsvps              EventRsvp[]
  shareLinks         EventShareLink[]
  notificationEvents NotificationEvent[]

  @@index([seriesId, startsAt])
  @@index([status])
}

model EventRsvp {
  id           String     @id @default(cuid())
  instanceId   String
  userId       String
  status       RsvpStatus
  guestCount   Int        @default(0)
  partySize    Int        @default(1)
  waitlistRank Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  instance EventInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instanceId, userId])
  @@index([instanceId, status])
}

model EventShareLink {
  id         String    @id @default(cuid())
  token      String    @unique
  seriesId   String?
  instanceId String?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  series   EventSeries?   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  instance EventInstance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model NotificationEvent {
  id         String                @id @default(cuid())
  type       NotificationEventType
  seriesId   String?
  instanceId String?
  actorId    String?
  payload    Json
  createdAt  DateTime              @default(now())

  series     EventSeries?           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  instance   EventInstance?         @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([type, createdAt])
}

model NotificationDelivery {
  id                  String                     @id @default(cuid())
  notificationEventId String
  userId              String
  channel             NotificationChannel
  status              NotificationDeliveryStatus @default(pending)
  attempts            Int                        @default(0)
  lastError           String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  notificationEvent NotificationEvent @relation(fields: [notificationEventId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationEventId, userId, channel])
  @@index([status, createdAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  inApp     Boolean  @default(true)
  email     Boolean  @default(false)
  push      Boolean  @default(false)
  sms       Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
