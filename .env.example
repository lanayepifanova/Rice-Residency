# Postgres connection used at runtime by Prisma.
#
# This app expects Postgres running on the same machine. On macOS:
#   brew install postgresql@14
#   brew services start postgresql@14
#   createdb rice_residency
# The data lives on disk in the Postgres data directory, so it survives the dev
# server restarting, the browser closing, and a reboot.
DATABASE_URL="postgresql://<your-macos-username>@localhost:5432/rice_residency"

# Used by the Prisma CLI for migrations. With no connection pooler in front of
# Postgres, this is the same URL as above.
DIRECT_URL="postgresql://<your-macos-username>@localhost:5432/rice_residency"

# Optional. The public origin used to build share links. Derived from the
# incoming request when unset, which is correct for localhost.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Deployment. None of this is needed to run the app locally.
# ---------------------------------------------------------------------------

# The deployed database, used by `npm run db:push-live` to copy this machine's
# data up to the live site. Vercel writes the same string into the project's own
# environment as DATABASE_URL; this copy is only so the push script on this
# laptop knows where to push. Copy it from the Vercel dashboard:
# Storage -> your database -> ".env.local" tab.
# LIVE_DATABASE_URL="postgresql://..."
